# Browser-safe Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Never expose this value to browser code or commit it in a real .env file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only AfrStar integration. Leave disabled until the database migration
# is applied and all credentials and the public HTTPS callback URL are set.
AFRSTAR_ENABLED=false
AFRSTAR_MERCHANT_SN=your-afrstar-merchant-code
AFRSTAR_MERCHANT_AK=your-afrstar-merchant-access-key
AFRSTAR_MERCHANT_SK=your-afrstar-merchant-secret-key
YOLOTASK_HUB_CLIENT=your-yolotask-client-name
YOLOTASK_HUB_SECRET=your-yolotask-hmac-secret
AFRSTAR_CALLBACK_URL=https://your-site.example/api/afrstar-callback
# Optional; defaults to https://your-site.example/app/deposit.html?payment=return
AFRSTAR_RETURN_URL=
